{
  "name": "buddy-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI_Buddy resident driver: keeps one Mineflayer connection alive and hot-swaps the jev-agent intelligence as a hash-stamped Bun bundle.",
  "main": "agent-runner.mts",
  "scripts": {
    "build": "bun build.mts",
    "start": "bun agent-runner.mts",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "test": "bun test --timeout=120000 --max-concurrency=1 ./bun-tests",
    "contract-docs-check": "bun ../tools/check-contract-docs.mjs",
    "contract-docs-test": "bun test ./test-contract-docs.mts",
    "ladder-test": "bun test ./test-ladder.mts",
    "prereq-dominated-test": "bun ./test-prereq-dominated.mts",
    "station-world-outcome-test": "bun ./test-station-world-outcome.mts",
    "descend-domination-test": "bun ./test-descend-domination.mts",
    "ladder-floor-test": "bun test ./test-ladder-floor.mts",
    "option-ladder-test": "bun test ./test-option-ladder.mts",
    "retrieval-body-test": "bun test ./test-retrieval-body.mts",
    "known-resource-test": "bun test ./test-known-resource.mts",
    "smelt-furnace-test": "bun test ./test-smelt-furnace.mts",
    "furnace-place-test": "bun test ./test-furnace-place.mts",
    "state-snapshot-test": "bun test ./test-state-snapshot.mts",
    "station-memory-test": "bun test ./test-station-memory.mts",
    "ledger-guard-test": "bun test ./test-ledger-guard.mts",
    "ledger-restore-test": "bun test ./test-ledger-restore.mts",
    "durable-writes-test": "bun test ./test-durable-writes.mts",
    "skill-strategy-test": "bun test ./test-skill-strategy.mts",
    "observability-test": "bun test ./test-observability.mts",
    "planner-mode-test": "bun test ./test-planner-mode.mts",
    "authority-test": "bun test ./test-planner-mode.mts && bun test ./test-authority-no-bypass.mts && bun test ./test-jev-prompt-authority.mts && bun test ./test-ai-authority-overhaul.mts && bun test ../jev-agent/test-controller-authority.mts && bun test ../jev-agent/test-option-authority-default.mts && bun test ../jev-agent/test-beta-option-threshold.mts",
    "simdeath-test": "bun test ./test-simdeath.mts",
    "reconnect-lease-test": "bun test ./test-reconnect-lease.mts",
    "reload-lifecycle-test": "bun test ./test-reload-lifecycle.mts",
    "world-epoch-test": "bun test ./test-world-epoch.mts",
    "actuation-port-test": "bun test ./test-actuation-port.mts",
    "mercury-test": "bun test ./test-mercury.mts",
    "mercury-authority-wiring-test": "bun test ./test-mercury-authority-wiring.mts",
    "system2-causal-authority-test": "bun test ./test-system2-causal-authority.mts",
    "mercury-count-budget-test": "bun test ./test-mercury-count-budget.mts",
    "mercury-portal-capabilities-test": "bun test ./test-mercury-portal-capabilities.mts",
    "mercury-local-transport-test": "bun test ./test-mercury-local-transport.mts",
    "post-death-context-test": "bun test ./test-post-death-context.mts",
    "advisor-cache-test": "bun test ./test-advisor-cache.mts",
    "plan-tail-test": "bun test ./test-plan-tail.mts",
    "m2-snapshot-test": "bun test ./test-m2-snapshot.mts",
    "mercury:last": "bun -e 'const text = await Bun.file(\"logs/jev/mercury-calls.jsonl\").text(); console.log(JSON.stringify(JSON.parse(text.trim().split(\"\\n\").at(-1)), null, 2))'",
    "local-mercury-authority-test": "bun test ./test-local-mercury-authority.mts",
    "human-intent-test": "bun test ./test-human-intent.mts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ai": "^7.0.105",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "minecraft-data": "^3.116.0",
    "prismarine-block": "^1.23.0",
    "prismarine-entity": "^2.6.0",
    "prismarine-item": "^1.18.0",
    "prismarine-windows": "^2.10.0",
    "vec3": "^0.1.10",
    "zod": "3.25.76"
  }
}
