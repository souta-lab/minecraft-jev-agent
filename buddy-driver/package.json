{
  "name": "buddy-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI_Buddy resident driver: keeps one Mineflayer connection alive and hot-swaps the jev-agent intelligence as a hash-stamped esbuild bundle.",
  "main": "agent-runner.mts",
  "scripts": {
    "build": "node build.mts",
    "start": "node agent-runner.mts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "contract-docs-check": "node ../tools/check-contract-docs.mjs",
    "contract-docs-test": "node ../jev-agent/node_modules/.bin/tsx test-contract-docs.mts",
    "ladder-test": "node ../jev-agent/node_modules/.bin/tsx test-ladder.mts",
    "ladder-floor-test": "node ../jev-agent/node_modules/.bin/tsx test-ladder-floor.mts",
    "option-ladder-test": "node ../jev-agent/node_modules/.bin/tsx test-option-ladder.mts",
    "retrieval-body-test": "node ../jev-agent/node_modules/.bin/tsx test-retrieval-body.mts",
    "known-resource-test": "node ../jev-agent/node_modules/.bin/tsx test-known-resource.mts",
    "smelt-furnace-test": "node ../jev-agent/node_modules/.bin/tsx test-smelt-furnace.mts",
    "furnace-place-test": "node ../jev-agent/node_modules/.bin/tsx test-furnace-place.mts",
    "state-snapshot-test": "node ../jev-agent/node_modules/.bin/tsx test-state-snapshot.mts",
    "station-memory-test": "node ../jev-agent/node_modules/.bin/tsx test-station-memory.mts",
    "ledger-guard-test": "node ../jev-agent/node_modules/.bin/tsx test-ledger-guard.mts",
    "ledger-restore-test": "node ../jev-agent/node_modules/.bin/tsx test-ledger-restore.mts",
    "durable-writes-test": "node ../jev-agent/node_modules/.bin/tsx test-durable-writes.mts",
    "skill-strategy-test": "node ../jev-agent/node_modules/.bin/tsx test-skill-strategy.mts",
    "observability-test": "node ../jev-agent/node_modules/.bin/tsx test-observability.mts",
    "planner-mode-test": "node ../jev-agent/node_modules/.bin/tsx test-planner-mode.mts",
    "simdeath-test": "node ../jev-agent/node_modules/.bin/tsx test-simdeath.mts",
    "reconnect-lease-test": "node ../jev-agent/node_modules/.bin/tsx test-reconnect-lease.mts",
    "reload-lifecycle-test": "node ../jev-agent/node_modules/.bin/tsx test-reload-lifecycle.mts",
    "world-epoch-test": "node ../jev-agent/node_modules/.bin/tsx test-world-epoch.mts",
    "actuation-port-test": "node ../jev-agent/node_modules/.bin/tsx test-actuation-port.mts",
    "mercury-test": "node test-mercury.mts",
    "advisor-cache-test": "node test-advisor-cache.mts",
    "plan-tail-test": "node ../jev-agent/node_modules/.bin/tsx test-plan-tail.mts",
    "mercury:last": "tail -1 logs/jev/mercury-calls.jsonl | python3 -m json.tool"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5"
  }
}
