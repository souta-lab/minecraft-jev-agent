# Dependencies
node_modules/

# Runtime logs and traces
logs/
*.log
*.jsonl
runner*.out

# Resident runtime state / generated bundles
buddy-state.json
buddy-ledger.json
buddy-driver/buddy-ledger-stale-*.json
buddy-driver/data/

# Run-scoped acceptance artifacts (tools/run-artifacts.mjs); local evidence only
runs/

# `data/` dirs hold run artifacts; keep only the jev-agent *.mts probe sources
data/
!jev-agent/data/
jev-agent/data/*
!jev-agent/data/*.mts

# Secrets and local-only server config (NEVER commit)
server.properties
*.key
.env
.env.*
accounts.json
.config/kimaki-secrets/

# Minecraft server / world / launcher artifacts
*.jar
world/
world*/
bds/
mc-world-backups/
mc-server/
launch/data/
launch/data-*/
launch/game-*/
ops/launch/data/
ops/launch/data-*/
ops/launch/game-*/

# A Leaf/vanilla server accidentally run at the repository root generates these
# top-level dirs; the canonical server lives outside the repo (~/mc-server/).
/config/
/eula.txt
/plugins/
/libraries/
/versions/
/cache/
/banned-ips.json
/banned-players.json
/bukkit.yml
/commands.yml
