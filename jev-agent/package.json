  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^7.0.105",
    "mineflayer": "^4.39.0",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5"
