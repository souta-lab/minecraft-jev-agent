    "demo": "tsx demo.mts",
    "guard-test": "tsx test-guard.mts",
    "gating-test": "tsx test-gating.mts",
    "loop-test": "tsx test-loop.mts",
    "audit-test": "tsx test-audit.mts",
    "option-spec-test": "tsx test-option-spec.mts",
    "skill-candidate-test": "tsx test-skill-candidate.mts",
    "observability-test": "tsx test-observability.mts",
    "beta-authority-test": "tsx test-beta-authority.mts",
    "wire-prereq-beta-test": "tsx test-wire-prereq-beta.mts",
    "m1-test": "tsx test-m1.mts",
    "issue43-test": "tsx test-issue43.mts",
    "fuel-guard-test": "tsx test-fuel-guard.mts",
    "vertical-plan-test": "tsx test-vertical-plan.mts",
