{
  "schema": "feature-authority-map/v1",
  "purpose": "Machine-checkable map from feature domains to their actual production authority surfaces. Checked by bun-tests/feature-authority-map.test.ts against candidates.ts, executor.ts and reach/kernel-authority-map.ts. A surface listed here is an authority ENVELOPE: the domain's candidate paths may reach it; a surface not listed here must not be reachable from that domain's dispatch path.",
  "admissionKinds": {
    "flat-candidate": "QueuedGoal candidate admitted by executor.claim; mutation through the generation-leased actuation boundary only; terminalization via flat buildResult(done|failed|cancelled). NOT kernel-admitted.",
    "kernel-transition-contract": "VTR TransitionContract admitted via applyKernelCommand; mutation gated by kernel leases + single-use effect tokens; terminalization via kernel TERMINAL only."
  },
  "domains": {
    "navigation": {
      "owner": "executor.ts locomotion skills + packages/jev-agent/src/reach/ kernel-admitted reach contract",
      "candidateKinds": [
        "MOVE",
        "DESCEND",
        "STEP"
      ],
      "dispatch": {
        "MOVE": "runMove",
        "DESCEND": "runDescend",
        "STEP": "runStep"
      },
      "admission": "mixed",
      "kernelAdmitted": "partial",
      "kernelModules": [
        "reach/transition.ts",
        "reach/controller.ts",
        "reach/kernel-authority-map.ts"
      ],
      "contract": "mission-source reach walks: ReachTransitionContract (admissibleEffects=[locomotion] -> claims body.locomotion+body.orientation, MOVE permit reach:leg). Other locomotion: flat Candidate.",
      "mutationSurfaces": [
        "pathfinder.setGoal",
        "pathfinder.setMovements",
        "pathfinder.goto",
        "pathfinder.stop",
        "bot.setControlState",
        "bot.clearControlStates",
        "bot.look",
        "bot.lookAt",
        "bot.dig",
        "bot.stopDigging",
        "bot.placeBlock",
        "bot._placeBlockWithOptions",
        "bot.useOn",
        "bot.equip",
        "bot.unequip",
        "entity.position.write",
        "entity.yaw",
        "entity.pitch",
        "entity.onGround",
        "entity.velocity.write",
        "bot.physicsEnabled",
        {
          "surface": "_client.write",
          "instance": "position"
        },
        {
          "surface": "_client.write",
          "instance": "position_look"
        },
        {
          "surface": "_client.write",
          "instance": "look"
        },
        {
          "surface": "_client.write",
          "instance": "flying"
        }
      ],
      "resourceDomains": [
        "body",
        "world",
        "interaction",
        "equipment",
        "inventory"
      ],
      "effects": [
        "MOVE",
        "LOOK",
        "DIG",
        "PLACE",
        "INTERACT",
        "EQUIP"
      ],
      "observation": "path progress deltas, position/closing evidence, worldMemory cell state; kernel-admitted legs additionally record verified facts",
      "verification": "flat: per-skill verified progress flags + buildResult; reach legs: kernel VERIFY_SUCCESS over fresh facts",
      "cancellation": "AbortSignal + epoch fencing -> ActionCancelled -> cancelled result; pathfinder.stop quiesces in-flight motion",
      "terminalization": "flat buildResult(done|failed|cancelled) for executor legs; kernel TERMINAL for reach-contract legs"
    },
