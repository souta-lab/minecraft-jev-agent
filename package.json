{
  "name": "mc-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Minecraft Jev agent: resident orchestrator, tools, and evidence gates",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "jev-agent",
    "buddy-driver",
    "mcbot",
    "mcbot/movement-test",
    "mcbot/movement-test/variants/A",
    "companion"
  ],
  "scripts": {
    "postinstall": "bun run --cwd jev-agent postinstall",
    "build": "bun run --cwd buddy-driver build",
    "typecheck": "bun run --cwd jev-agent typecheck && bun run --cwd buddy-driver typecheck",
    "test": "bun test --timeout=120000 --max-concurrency=1 ./bun-tests",
    "mcp-test": "bun test/mcp-test.js",
    "bun-residue-check": "bun tools/bun-residue-check.mjs",
    "movement-patch:check": "bun run --cwd jev-agent movement-patch:check",
    "lane-guard": "bun tools/lane-guard.mjs",
    "issue-graph": "bun tools/issue-graph.mjs",
    "current-status": "bun tools/current-status.mjs",
    "current-status:write": "bun tools/current-status.mjs --write",
    "frontier": "bun tools/frontier.mjs",
    "frontier:check": "bun tools/frontier.mjs --check",
    "frontier:write": "bun tools/frontier.mjs --write",
    "issue-state": "bun tools/issue-state.mjs",
    "issue-state:check": "bun tools/issue-state.mjs --check",
    "milestone-status": "bun tools/milestone-status.mjs",
    "milestone-status:check": "bun tools/milestone-status.mjs --check",
    "m2-watch": "bun tools/m2-watch.mjs",
    "m2-acceptance": "bun tools/m2-acceptance.mjs",
    "m2-live-gate": "bun tools/m2-live-gate.mjs",
    "m2-gate": "bun tools/m2-gate.mjs",
    "lane-guard-test": "bun tools/test-lane-guard.mjs",
    "issue-graph-test": "bun tools/test-issue-graph.mjs",
    "current-status-test": "bun tools/test-current-status.mjs",
    "frontier-test": "bun tools/test-frontier.mjs",
    "issue-state-test": "bun tools/test-issue-state.mjs",
    "milestone-status-test": "bun tools/test-milestone-status.mjs",
    "m2-watch-test": "bun tools/test-m2-watch.mjs",
    "m2-acceptance-test": "bun tools/test-m2-acceptance.mjs",
    "m2-live-gate-test": "bun tools/test-m2-live-gate.mjs",
    "m2-gate-test": "bun tools/test-m2-gate.mjs",
    "m2-policy-evidence-test": "bun tools/test-m2-policy-evidence.mjs",
    "m2-snapshot-evidence-test": "bun tools/test-m2-snapshot-evidence.mjs",
    "run-artifacts-test": "bun tools/test-run-artifacts.mjs",
    "issue13-evidence-test": "bun tools/test-issue13-evidence.mjs",
    "world-state": "bun tools/world-player-state.mjs",
    "world-state-test": "bun tools/test-world-player-state.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "bedrock-protocol": "3.59.0",
    "zod": "4.6.5"
  }
}
